#cloud-config
packages:
  - docker.io
  - git

write_files:
  - path: /etc/profile.d/env.sh
    content: |
      # Export environment variables here
      export MY_ENV_VAR="your_value"

runcmd:
  # Install Docker (officially supports ARM64)
  - systemctl start docker
  - systemctl enable docker

  # Set up SSH for GitHub (Ensure you have your SSH private key available)
  - mkdir -p /root/.ssh
  - echo "YOUR_PRIVATE_KEY" > /root/.ssh/id_rsa
  - chmod 600 /root/.ssh/id_rsa
  - ssh-keyscan github.com >> /root/.ssh/known_hosts

  # Create the ~/aesthetic directory and clone the repository into it
  - mkdir -p ~/aesthetic
  - git clone git@github.com:lieranaderl/qwik-aestheticlab.git ~/aesthetic

  # Navigate to the repository and run docker-compose build
  - cd ~/aesthetic
  - docker volume create caddy_data
  - docker volume create n8n_data
  - docker compose build # Using docker compose directly with Docker v2.x

  # Remove all files and directories except for n8n_files, caddy_config, Dockerfile, and docker-compose.yaml
  - find ~/aesthetic -mindepth 1 ! -name 'n8n_files' ! -name 'caddy_config' ! -name 'Dockerfile' ! -name 'docker-compose.yaml' -exec rm -rf {} +

  # Start containers in detached mode
  - docker compose up -d

  # Import credentials and workflows for n8n
  - docker exec -it n8n sh -c "n8n import:credentials --input=/files/creds.json && n8n import:workflow --input=/files/workflows.json && n8n update:workflow --id=PgnuLOJDGJgX1OeB --active=true"

  # Restart the n8n service using docker compose
  - docker compose restart n8n
