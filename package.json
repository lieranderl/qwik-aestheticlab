{
  "name": "aestheticlab",
  "description": "AestheticLab",
  "engines": {
    "node": "^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "trustedDependencies-annotation": "Needed for bun to allow running install scripts",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/bun/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "docker.build": "docker buildx build --platform linux/amd64 -t furlingene/qwik-aesthetic:staging-newcal-v11 . --push",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "bunx eslint .",
    "preview": "qwik build preview && vite preview --open",
    "serve": "bun server/entry.bun.js",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "biome": "biome check --fix",
    "qwik-speak-extract": "qwik-speak-extract --supportedLangs=en-BE,nl-BE,fr-BE,ru-BE,uk-BE --assetsPath=i18n"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.17.1",
    "@builder.io/qwik-city": "^1.17.1",
    "@eslint/js": "latest",
    "@types/node": "20.14.11",
    "eslint": "9.25.1",
    "eslint-plugin-qwik": "^1.17.1",
    "globals": "16.0.0",
    "prettier": "3.3.3",
    "typescript": "5.4.5",
    "typescript-eslint": "8.26.1",
    "undici": "^7.16.0",
    "vite": "5.3.5",
    "vite-tsconfig-paths": "^4.3.2",
    "@biomejs/biome": "^2.3.1",
    "@ditadi/qwik-hooks": "^0.1.6",
    "@qwikest/icons": "^0.0.13",
    "@types/bun": "^1.3.1",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "daisyui": "^5.3.10",
    "luxon": "^3.7.2",
    "qwik-speak": "^0.23.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/luxon": "^3.7.1",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7"
  }
}
